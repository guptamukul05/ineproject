# Copy to backend/.env and fill in. Never commit the real .env.

DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=true

# Supabase -> Project Settings -> Database -> Connection string -> URI
# Use the SESSION POOLER URI (port 5432) — the direct connection is IPv6-only
# and Render's free tier cannot reach it.
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Shared secret the cron service must send. Make it long and random.
CRON_SECRET=another-long-random-string

STORE_BASE_URL=https://demo.inelabteamdev.com
SCRAPE_INTERVAL_MINUTES=120
PLAYWRIGHT_ENABLED=true

# Comma-separated, no spaces. Add your Vercel URL once you have it.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_ALL=true
